{
  "name": "dashboard-desktop",
  "version": "0.3.0-dev",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "pack:win": "npm run prepare:renderer && electron-packager . DashBoard --platform=win32 --arch=x64 --out=../release --overwrite --asar --prune=true",
    "prepare:renderer": "node prepare-renderer.cjs",
    "test": "node --test database.test.cjs"
  },
  "dependencies": {
    "better-sqlite3": "12.4.1"
  },
  "devDependencies": {
    "@electron/rebuild": "4.0.1",
    "@electron/packager": "19.0.1",
    "electron": "38.2.2"
  }
}
